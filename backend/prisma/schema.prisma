generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDOR
  SUPPORT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum StoreCurrency {
  NGN
  ZAR
}

enum TicketPriority {
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String
  role         Role
  storeName    String?
  status       UserStatus     @default(ACTIVE)
  createdAt    DateTime       @default(now()) @db.Date
  products     Product[]
  orders       Order[]        @relation("CustomerOrders")
  vendorItems  OrderItem[]    @relation("VendorOrderItems")
  tickets      SupportTicket[]

  @@index([role])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String        @id @default(cuid())
  vendorId      String
  vendor        User          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name          String
  category      String
  price         Int
  originalPrice Int
  image         String
  images        String[]      @default([])
  sku           String        @default("")
  shortDescription String     @default("")
  description   String[]      @default([])
  descriptionBullets String[] @default([])
  tags          String[]      @default([])
  sizes         String[]      @default([])
  additionalInfo Json         @default("[]")
  rating        Float         @default(0)
  discount      String        @default("")
  stock         Int
  status        ProductStatus @default(PENDING)
  submittedAt   DateTime      @default(now()) @db.Date
  reviewedAt    DateTime?     @db.Date
  orderItems    OrderItem[]

  @@index([vendorId])
  @@index([status])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String?
  customer          User?       @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String      @default("")
  status            OrderStatus @default(PENDING)
  total             Int
  itemCount         Int
  currency          StoreCurrency @default(NGN)
  paymentMethod     String        @default("Paystack")
  paymentStatus     PaymentStatus @default(PENDING)
  paymentReference  String?       @unique
  paidAt            DateTime?
  orderDate         DateTime      @default(now()) @db.Date
  shippingAddress   String        @default("")
  shippingFee       Int           @default(0)
  deliveryCity      String        @default("")
  deliveryLatitude  Float?
  deliveryLongitude Float?
  carrier           String        @default("Kwik")
  trackingNumber    String?
  kwikTrackingUrl   String?
  estimatedDelivery String?
  items             OrderItem[]
  createdAt         DateTime      @default(now())

  @@index([status])
  @@index([customerEmail])
  @@index([paymentReference])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId  String?
  vendor    User?    @relation("VendorOrderItems", fields: [vendorId], references: [id], onDelete: SetNull)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  sku       String   @default("")
  quantity  Int
  unitPrice Int
  image     String?

  @@index([orderId])
  @@index([vendorId])
}

model SupportTicket {
  id            String         @id @default(cuid())
  ticketNumber  String         @unique
  subject       String
  customerName  String
  customerEmail String
  customerId    String?
  customer      User?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  orderNumber   String?
  createdAt     DateTime       @default(now())

  @@index([status])
}
